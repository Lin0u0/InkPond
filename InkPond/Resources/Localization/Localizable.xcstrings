    "app_fonts.export_warning.message" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Project ZIP exports only the project directory. App, system, and installed fonts are not bundled and must exist separately on the destination device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目 ZIP 只会导出项目目录。App 字体、系统字体和系统已安装字体都不会被打包，目标设备需单独提供这些字体。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案 ZIP 只會匯出專案目錄。App 字型、系統字型與系統已安裝字型都不會被打包，目標裝置需另行提供這些字型。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案 ZIP 只會匯出專案目錄。App 字型、系統字型與系統已安裝字型都不會被打包，目標裝置需另行提供這些字型。"
          }
        }
      }
