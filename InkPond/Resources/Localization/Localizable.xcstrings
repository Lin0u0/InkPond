    "app_fonts.overview.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imported App fonts are available to every project. System and installed fonts can be used when a document explicitly references them. Project ZIP exports do not bundle App, system, or installed fonts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入的 App 字体对所有项目可用。文档显式引用时，也可以使用系统字体和系统已安装字体。导出的项目 ZIP 不会打包 App、系统或系统已安装字体。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已匯入的 App 字型可供所有專案使用。文件明確引用時，也可使用系統字型與系統已安裝字型。匯出專案 ZIP 時不會打包 App、系統或系統已安裝字型。"
          }
        },
        "zh-Hant-TW" : {
